NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel

# Server-only: usada na sincronização PNCP e no billing Sandbox. Nunca usar NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Opcional: habilita geração de análises novas por IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Opcional: sem estas variáveis, alertas rodam em modo simulação com logs no servidor.
EMAIL_ALERTS_PROVIDER=resend
EMAIL_ALERTS_API_KEY=
EMAIL_ALERTS_FROM="Oportuna <onboarding@resend.dev>"

# Recomendado em produção: protege o endpoint usado por Vercel Cron.
CRON_SECRET=

# Billing desta branch: somente Asaas Sandbox + Supabase de homologacao.
# Valores de teste; altere apenas estas variaveis para ajustar preco e franquia.
# Nunca prefixar a chave Asaas com NEXT_PUBLIC_.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PRO_MONTHLY_PRICE=99.00
BUSINESS_MONTHLY_PRICE=197.00
PRO_MONTHLY_AI_LIMIT=200
BUSINESS_MONTHLY_AI_LIMIT=1000
APP_BASE_URL=
